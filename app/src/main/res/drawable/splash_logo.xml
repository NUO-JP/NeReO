    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- anello esterno -->
    <path
        android:strokeColor="#8E5CF0"
        android:strokeWidth="3.2"
        android:fillColor="#00000000"
        android:pathData="M54,20 A34,34 0 1 1 53.99,20 Z" />
    <!-- anello interno -->
    <path
        android:strokeColor="#6E4BB8"
        android:strokeWidth="2.4"
        android:fillColor="#00000000"
        android:pathData="M54,29 A25,25 0 1 1 53.99,29 Z" />

    <!-- "N" (lavanda chiaro) -->
    <path
        android:fillColor="#EDE7F6"
        android:pathData="M38,38 h5 l7,13 v-13 h5 v28 h-5 l-7,-13 v13 h-5 z" />
    <!-- "R" (viola chiaro) -->
    <path
        android:fillColor="#B99CF7"
        android:pathData="M55,38 h9 a7,7 0 0 1 0,14 h-2 l5,14 h-5 l-5,-14 v14 h-4 v-28 z M59,42 v6 h4 a3,3 0 0 0 0,-6 z" />
